<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#B8860B"
                android:endColor="#8C6808" />
            <stroke android:width="2dp" android:color="#FFF3B0" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#E5C04D"
                android:endColor="#C79211" />
            <stroke android:width="2dp" android:color="#FFF3B0" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
